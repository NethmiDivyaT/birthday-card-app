# Session signing — use a long random string in production
AUTH_SECRET=change-me-to-a-long-random-string

# Required on Vercel (Turso Cloud). Local dev can omit these and use data/birthday.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required on Vercel for photo/video uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
